# Copy to sysmon.env to change launcher defaults (read by bin/sysmon).
# Listen on all interfaces so other computers on the LAN can open the page.
# There is no login: anyone who can reach the port sees process command lines.
SYSMON_BIND=0.0.0.0

# Extra server.py arguments used by every start/restart.
#SYSMON_ARGS="--port 8765 --interval 2 --keep 60"
